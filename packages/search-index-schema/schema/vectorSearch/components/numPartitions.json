{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vectorSearch/components/numPartitions.json",
  "description": "Number of index partitions. Allowed values are [1, 2, 4].",
  "markdownDescription": "Number of [index partitions](https://dochub.mongodb.org/core/atlas-search-index-partition). Allowed values are [1, 2, 4].",
  "default": 1,
  "oneOf": [{ "const": 1 }, { "const": 2 }, { "const": 4 }],
  "type": "integer"
}
